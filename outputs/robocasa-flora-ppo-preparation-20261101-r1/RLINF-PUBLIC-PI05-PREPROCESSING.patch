+def map_released_control_scores(actions, action_space_cfg):
+    """Map published [0,1] score controls without mutating PPO actions.
+
+    Native PandaOmronKeyConverter.unmap_action thresholds gripper and mode
+    at0.5. The other continuous controls remain byte-identical.
+    """
+    mapped = np.array(actions, copy=True)
+    if mapped.shape[-1] != int(action_space_cfg.get("env_action_dim", 12)):
+        raise ValueError("RoboCasa365 action width differs from native controller")
+    if not np.isfinite(mapped).all():
+        raise ValueError("Nonfinite policy action cannot enter RoboCasa365")
+    if action_space_cfg.get("binarize_gripper_control", False):
+        index = int(action_space_cfg.get("gripper_index", 6))
+        mapped[..., index] = np.where(mapped[..., index] < 0.5, -1.0, 1.0)
+    if action_space_cfg.get("binarize_base_mode_control", False):
+        index = int(action_space_cfg.get("base_mode_index", 11))
+        mapped[..., index] = np.where(mapped[..., index] < 0.5, -1.0, 1.0)
+    return mapped
 
 
 class Robocasa365Env(gym.Env):
