  "function_lines": [
    "    def _check_success(self):",
    "        \"\"\"",
    "        Check if the drawer manipulation task is successful.",
    "",
    "        Returns:",
    "            bool: True if the task is successful, False otherwise.",
    "        \"\"\"",
    "        door_state = self.drawer.get_door_state(env=self)",
    "",
    "        success = True",
    "        for joint_p in door_state.values():",
    "            if self.behavior == \"open\":",
    "                if joint_p < 0.95:",
    "                    success = False",
    "                    break",
    "            elif self.behavior == \"close\":",
    "                if joint_p > 0.05:",
    "                    success = False",
    "                    break",
    "",
    "        return success",
    "",
    "",
    "class OpenDrawer(ManipulateDrawer):"
  ],
  "criterion": "Open: every target drawer state >=0.95; simulator sidecar uses success_at_end, not best visual progress in the video"
}
